---
interface Props {
  url: string;
  title: string;
}

const { url, title } = Astro.props;
const encodedUrl = encodeURIComponent(url);
const encodedTitle = encodeURIComponent(title);
---

<div class="share-buttons" data-share-url={url}>
  <span class="share-label">Chia sẻ bài viết</span>
  <div class="share-row">
    <!-- Facebook -->
    <a href={`https://www.facebook.com/sharer/sharer.php?u=${encodedUrl}`}
       class="share-btn" target="_blank" rel="noopener noreferrer" aria-label="Chia sẻ qua Facebook">
      <svg viewBox="0 0 24 24" fill="currentColor"><path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/></svg>
    </a>
    <!-- Zalo -->
    <a href={`https://sp.zalo.me/share?u=${encodedUrl}&t=${encodedTitle}`}
       class="share-btn" target="_blank" rel="noopener noreferrer" aria-label="Chia sẻ qua Zalo">
      <svg viewBox="0 0 24 24" fill="currentColor"><path d="M12 0C5.373 0 0 5.373 0 12s5.373 12 12 12 12-5.373 12-12S18.627 0 12 0zm0 22C6.486 22 2 17.514 2 12S6.486 2 12 2s10 4.486 10 10-4.486 10-10 10z"/><path d="M17.5 12.5c0 2.5-3 4.5-6 4.5-1 0-2-.2-2.8-.5-.2-.1-.4-.1-.5 0L6 17.5l.5-2c0-.2 0-.4-.1-.5-.3-.8-.4-1.6-.4-2.5 0-2.5 3-4.5 6-4.5s6 2 6 4.5z"/><circle cx="9.5" cy="11.5" r="1" fill="#fff"/><circle cx="14.5" cy="11.5" r="1" fill="#fff"/></svg>
    </a>
    <!-- X (Twitter) -->
    <a href={`https://x.com/intent/tweet?url=${encodedUrl}&text=${encodedTitle}`}
       class="share-btn" target="_blank" rel="noopener noreferrer" aria-label="Chia sẻ qua X">
      <svg viewBox="0 0 24 24" fill="currentColor"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>
    </a>
    <!-- LinkedIn -->
    <a href={`https://www.linkedin.com/sharing/share-offsite/?url=${encodedUrl}`}
       class="share-btn" target="_blank" rel="noopener noreferrer" aria-label="Chia sẻ qua LinkedIn">
      <svg viewBox="0 0 24 24" fill="currentColor"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/></svg>
    </a>
    <!-- Copy link -->
    <button type="button" class="share-btn" aria-label="Sao chép liên kết" data-copy-link>
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="9" y="9" width="13" height="13" rx="2" ry="2"/><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/></svg>
    </button>
  </div>
  <span class="copy-toast" hidden>Đã sao chép!</span>
</div>

<script>
  document.querySelectorAll('.share-buttons').forEach((el) => {
    const btn = el.querySelector<HTMLButtonElement>('[data-copy-link]');
    const toast = el.querySelector<HTMLElement>('.copy-toast');
    const shareUrl = (el as HTMLElement).dataset.shareUrl || '';

    btn?.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(shareUrl);
      } catch {
        const ta = document.createElement('textarea');
        ta.value = shareUrl;
        ta.style.position = 'fixed';
        ta.style.opacity = '0';
        document.body.appendChild(ta);
        ta.select();
        document.execCommand('copy');
        document.body.removeChild(ta);
      }
      if (toast) {
        toast.hidden = false;
        setTimeout(() => { toast.hidden = true; }, 2000);
      }
    });
  });
</script>

<style>
  .share-buttons {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 12px;
    padding: 16px 0 4px;
    position: relative;
  }
  .share-label {
    font-size: .88rem;
    font-weight: 600;
    color: var(--muted);
  }
  .share-row {
    display: flex;
    gap: 10px;
    align-items: center;
  }
  .share-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 42px;
    height: 42px;
    border-radius: 50%;
    border: 1px solid var(--line);
    background: #fff;
    color: var(--navy);
    cursor: pointer;
    transition: all .15s;
    text-decoration: none;
    padding: 0;
  }
  .share-btn:hover {
    background: var(--navy);
    color: #fff;
    border-color: var(--navy);
  }
  .share-btn svg {
    width: 18px;
    height: 18px;
  }
  .copy-toast {
    font-size: .82rem;
    color: #2d8a56;
    font-weight: 600;
    position: absolute;
    bottom: -6px;
  }
</style>

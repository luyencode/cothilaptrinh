---
import { nav, isActive } from '../data/nav';

interface Props {
  currentPath: string;
}
const { currentPath } = Astro.props;
---
<header class="top"><div class="wrap">
  <a class="logo" href="/"><span class="mark"><i></i><i></i><i></i><i></i></span><span><b>Cô Thi</b> <em>Lập Trình</em></span></a>
  <button class="burger" aria-label="Mở menu" onclick="document.body.classList.toggle('nav-open')"><span></span><span></span><span></span></button>
  <nav class="nav" aria-label="Menu chính">
    {nav.map((item) => {
      const on = isActive(item.href, currentPath);
      return <a href={item.href} class={on ? 'on' : undefined} aria-current={on ? 'page' : undefined}>{item.label}</a>;
    })}
  </nav>
  <a class="btn btn-green" href="https://zalo.me/0985188655" target="_blank" rel="noopener">Tư vấn qua Zalo</a>
</div></header>

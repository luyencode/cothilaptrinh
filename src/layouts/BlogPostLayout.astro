---
import BaseLayout from './BaseLayout.astro';
import ShareButtons from '../components/ShareButtons.astro';
import ZaloGroupCTA from '../components/ZaloGroupCTA.astro';

interface Props {
  title: string;
  description: string;
  date: Date;
  tags: string[];
  accent?: string;
  cover?: string;
  author?: string;
}
const { title, description, date, tags, accent = '#1E3A63', cover, author = 'Đặng Kim Thi' } = Astro.props;
const formattedDate = date.toLocaleDateString('vi-VN', { day: 'numeric', month: 'long', year: 'numeric' });
const canonicalURL = new URL(Astro.url.pathname, Astro.site).href;
---
<BaseLayout
  title={`${title} | Cô Thi Lập Trình`}
  description={description}
  accent={accent}
  heroClass="lighthero"
  ogImage={cover}
  ogType="article"
  publishedTime={date}
>
  <section class="hero tint"><div class="wrap narrow">
    <span class="eyebrow"><svg width="1em" height="1em" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20M4 19.5A2.5 2.5 0 0 0 6.5 22H20V2H6.5A2.5 2.5 0 0 0 4 4.5v15z"/></svg> Blog</span>
    <h1>{title}</h1>
    <p class="lead">{description}</p>
    <div class="post-meta">
      <span class="post-author"><svg width="1em" height="1em" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg> {author}</span>
      <span>{formattedDate}</span>
      {tags.length > 0 && (
        <span class="post-tags">
          {tags.map((t) => <span class="post-tag">{t}</span>)}
        </span>
      )}
    </div>
  </div></section>

  {cover && (
    <div class="wrap narrow">
      <img class="post-cover" src={cover} alt={title} width="1200" height="630" loading="eager" />
    </div>
  )}

  <div class="wrap narrow">
    <ShareButtons url={canonicalURL} title={title} />
  </div>

  <!-- Post shell: left ToC | center content | right sticky CTA -->
  <div class="post-shell">
    <aside class="post-toc" aria-label="Mục lục">
      <div class="toc-inner">
        <div class="toc-head">
          <span class="toc-icon" aria-hidden="true">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M8 6h13M8 12h13M8 18h13"/><path d="M3 6h.01M3 12h.01M3 18h.01"/></svg>
          </span>
          <p class="toc-title">Mục lục</p>
          <span class="toc-count" id="toc-count" aria-hidden="true"></span>
        </div>
        <nav id="toc-nav" class="toc-nav"></nav>
      </div>
    </aside>

    <div class="post-main">
      <section class="section post-section"><div class="post-content" id="post-content">
        <slot />
      </div></section>

      <!-- Mobile mid CTA injected via JS after 2nd h2; hidden template for cloning -->
      <div id="zg-mid-template" hidden>
        <ZaloGroupCTA variant="compact" showQR={false} title="Chia sẻ về AI, Lập trình, Cách học" desc="Bạn vào nhóm Zalo này để cập nhật cách học hiệu quả, cách dùng AI đúng và tài liệu luyện thi Tin học." />
      </div>

      <div class="post-bottom-share">
        <ShareButtons url={canonicalURL} title={title} />
      </div>

      <section class="section soft post-back"><div class="center">
        <a class="btn btn-navy" href="/blog"><svg width="1em" height="1em" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M19 12H5M12 19l-7-7 7-7"/></svg> Xem tất cả bài viết</a>
      </div></section>
    </div>

    <aside class="post-cta-side" aria-label="Nhóm Zalo">
      <div class="post-cta-sticky">
        <ZaloGroupCTA variant="sidebar" showQR={true} title="Chia sẻ về AI, Lập trình, Cách học" desc="Cập nhật cách học hiệu quả, cách dùng AI đúng và tài liệu luyện thi Tin học. Quét mã hoặc bấm tham gia." />
      </div>
    </aside>
  </div>
</BaseLayout>

<script>
  // External links: open outside cothilaptrinh.vn in new tab
  document.querySelectorAll('.post-content a').forEach((a) => {
    const href = a.getAttribute('href') || '';
    if (/^https?:\/\//i.test(href) && !href.includes('cothilaptrinh.vn')) {
      a.setAttribute('target', '_blank');
      a.setAttribute('rel', 'noopener noreferrer');
    }
  });

  // Build ToC from h2/h3 inside post-content — improved UI
  (function(){
    const content = document.getElementById('post-content');
    const tocNav = document.getElementById('toc-nav');
    const tocAside = document.querySelector('.post-toc');
    const tocCount = document.getElementById('toc-count');
    if (!content || !tocNav) return;
    const headings = content.querySelectorAll('h2, h3');
    if (headings.length < 2) {
      if (tocAside) (tocAside as HTMLElement).style.display = 'none';
      return;
    }
    if (tocCount) tocCount.textContent = `${headings.length}`;
    const ul = document.createElement('ul');
    headings.forEach((h, i) => {
      if (!h.id) {
        const slug = (h.textContent||'').trim().toLowerCase()
          .normalize('NFD').replace(/[\u0300-\u036f]/g,'')
          .replace(/[^a-z0-9]+/g,'-').replace(/^-|-$/g,'') || `sec-${i}`;
        h.id = slug;
      }
      const li = document.createElement('li');
      li.className = h.tagName === 'H3' ? 'toc-h3' : 'toc-h2';
      const a = document.createElement('a');
      a.href = `#${h.id}`;
      a.textContent = (h.textContent||'').trim();
      a.setAttribute('data-toc-link', '');
      li.appendChild(a);
      ul.appendChild(li);
    });
    tocNav.appendChild(ul);

    // Smooth scroll with offset for sticky header
    tocNav.addEventListener('click', (e) => {
      const a = (e.target as HTMLElement).closest('a[href^="#"]') as HTMLAnchorElement | null;
      if (!a) return;
      const id = a.getAttribute('href')!.slice(1);
      const target = document.getElementById(id);
      if (!target) return;
      e.preventDefault();
      const top = target.getBoundingClientRect().top + window.scrollY - 88;
      window.scrollTo({ top, behavior: 'smooth' });
      history.pushState(null, '', `#${id}`);
    });

    // Active section highlight — most visible heading wins
    const links = tocNav.querySelectorAll('a');
    let activeId: string | null = null;
    const observer = new IntersectionObserver((entries)=>{
      const visible = entries.filter(e=>e.isIntersecting).sort((a,b)=> b.intersectionRatio - a.intersectionRatio);
      if (!visible.length) return;
      const id = (visible[0].target as HTMLElement).id;
      if (id !== activeId) {
        activeId = id;
        links.forEach(l=> l.classList.toggle('on', l.getAttribute('href')===`#${id}`));
      }
    }, { rootMargin:'-18% 0px -62% 0px', threshold:[0, 0.2, 0.5, 1] });
    headings.forEach(h=> observer.observe(h));
  })();

  // Mid-article CTA injection: mobile/tablet (<1200px) after 2nd h2, desktop removes it — matches ToC breakpoint
  (function(){
    const mq = window.matchMedia('(max-width: 1200px)');
    const tmpl = document.getElementById('zg-mid-template');
    let injectedEl: HTMLElement | null = null;

    function inject(){
      const isMobile = mq.matches;
      const h2s = document.querySelectorAll('#post-content h2');
      // Remove existing injected if any
      if (injectedEl && injectedEl.parentNode) injectedEl.remove();
      injectedEl = null;

      if (!isMobile) return;
      if (!tmpl || h2s.length < 2) return;
      const target = h2s[1] as HTMLElement;
      // Don't inject if already near the end CTA or if content short
      if (!target) return;
      const clone = tmpl.firstElementChild?.cloneNode(true) as HTMLElement | null;
      if (!clone) return;
      clone.hidden = false;
      // The clone contains ZaloGroupCTA markup; its script handler is delegated so no extra init needed
      // Insert after target's next block: find following sibling that is not heading, or just after h2's parent section
      // Use target.insertAdjacentElement for simplicity
      target.insertAdjacentElement('afterend', clone);
      injectedEl = clone;
    }

    inject();
    mq.addEventListener('change', inject);
  })();
</script>

<style>
  .post-cover { display: block; width: 100%; height: auto; border-radius: var(--r); margin-top: 28px; box-shadow: 0 22px 48px rgba(16,30,55,.16); border: 1px solid var(--line); }
  .post-author { display: inline-flex; align-items: center; gap: .4em; font-weight: 700; color: var(--navy); }
  .post-meta { display: flex; gap: 14px; align-items: center; margin-top: 18px; flex-wrap: wrap; color: var(--muted); font-size: .9rem; }
  .post-tags { display: flex; gap: 8px; flex-wrap: wrap; }
  .post-tag { background: color-mix(in srgb, var(--c) 12%, #fff); color: var(--navy); padding: 4px 12px; border-radius: 999px; font-weight: 600; font-size: .78rem; }
  .post-content :global(h2) { margin-top: 2em; margin-bottom: .6em; font-size: 1.5rem; scroll-margin-top: 88px; }
  .post-content :global(h3) { margin-top: 1.6em; margin-bottom: .5em; font-size: 1.2rem; scroll-margin-top: 88px; }
  .post-content :global(p) { margin-bottom: 1.1em; line-height: 1.75; }
  .post-content :global(ul), .post-content :global(ol) { margin: 0 0 1.1em 1.3em; line-height: 1.7; }
  .post-content :global(li) { margin-bottom: .4em; }
  .post-content :global(a) { color: var(--navy); text-decoration: underline; }
  .post-content :global(blockquote) { border-left: 3px solid var(--gold); padding-left: 16px; color: var(--muted); font-style: italic; margin: 1.2em 0; }
  .post-content :global(code) { background: #f1f3f8; padding: .15em .4em; border-radius: 6px; font-size: .9em; }
  .post-content :global(pre) { background: var(--navy-d); color: #e7eefb; padding: 16px 18px; border-radius: 14px; overflow-x: auto; margin: 1.2em 0; }
  .post-content :global(pre code) { background: none; padding: 0; color: inherit; }
  .post-content :global(img) { border-radius: var(--r); margin: 1.2em 0; }

  /* Post shell grid — ToC 300px = CTA 300px (symmetric rails) */
  .post-shell{ display:grid; grid-template-columns:300px minmax(0,760px) 300px; gap:28px; width:min(1440px,94vw); margin:0 auto; align-items:start; padding-bottom:40px; }
  .post-main{ min-width:0; }
  .post-section{ padding: 40px 0 8px; }
  .post-bottom-share{ padding: 8px 0 0; border-top:1px solid var(--line); margin-top: 8px; }
  .post-back{ padding: 28px 0 10px; }

  /* ToC left — refined to match site design system */
  .post-toc{ position:sticky; top:88px; align-self:start; max-height:calc(100vh - 96px); overflow:auto; padding-top:40px; scrollbar-width:thin; scrollbar-color: var(--gray) transparent; }
  .post-toc::-webkit-scrollbar{ width:5px; }
  .post-toc::-webkit-scrollbar-thumb{ background:var(--gray); border-radius:999px; }
  .toc-inner{ background:#fff; border:1px solid var(--line); border-radius:var(--r); padding:0; box-shadow:0 8px 22px rgba(16,30,55,.06); overflow:hidden; }
  .toc-head{ display:flex; align-items:center; gap:8px; padding:14px 16px 12px; border-bottom:1px solid var(--line); background: linear-gradient(180deg, #fff, #fbfcfe); }
  .toc-icon{ flex:0 0 auto; width:26px; height:26px; border-radius:8px; display:grid; place-items:center; color:#fff; background: linear-gradient(135deg, var(--navy), var(--teal)); box-shadow:0 4px 10px rgba(30,58,99,.18); }
  .toc-title{ font-size:.74rem; font-weight:800; letter-spacing:1.4px; text-transform:uppercase; color:var(--navy); margin:0; }
  .toc-count{ margin-left:auto; font-size:.7rem; font-weight:700; color:var(--muted); background:#f1f3f8; border:1px solid var(--line); padding:2px 7px; border-radius:999px; min-width:20px; text-align:center; line-height:1.4; }
  .toc-nav{ padding:12px 10px 14px; }
  .toc-nav ul{ list-style:none; margin:0; padding:0; display:flex; flex-direction:column; gap:6px; }
  .toc-nav li{ line-height:1.4; }
  .toc-nav a{ display:flex; align-items:center; gap:9px; padding:7px 10px 7px 12px; border-radius:9px; font-size:.76rem; font-weight:600; letter-spacing:.15px; line-height:1.32; color:#33425c; border-left:3px solid transparent; border:1px solid transparent; background:#fff; text-decoration:none; transition:.16s background, .16s color, .16s border-color, .16s box-shadow, .16s transform; position:relative; box-shadow:0 1px 2px rgba(16,30,55,.03); font-family:var(--font); }
  .toc-nav a::before{ content:''; flex:0 0 auto; width:6px; height:6px; border-radius:50%; background:var(--gray); opacity:.95; transition:.16s background, .16s transform, .16s box-shadow; border:2px solid #fff; box-shadow:0 0 0 1px var(--line); }
  .toc-nav a:hover{ background: color-mix(in srgb, var(--teal) 9%, #fff); color:var(--navy); border-color: color-mix(in srgb, var(--teal) 18%, var(--line)); border-left-color: var(--teal); box-shadow:0 4px 14px rgba(46,130,150,.12); transform:translateX(1px); }
  .toc-nav a:hover::before{ background:var(--teal); border-color:#fff; box-shadow:0 0 0 2px color-mix(in srgb, var(--teal) 22%, transparent); transform:scale(1.12); }
  .toc-nav a.on{ color:var(--navy); background: color-mix(in srgb, var(--gold) 14%, #fff); border-color: color-mix(in srgb, var(--gold) 22%, var(--line)); border-left-color: var(--gold-d); font-weight:700; box-shadow:0 4px 14px rgba(242,193,61,.16); }
  .toc-nav a.on::before{ background:var(--gold-d); border-color:#fff; box-shadow:0 0 0 3px color-mix(in srgb, var(--gold) 26%, transparent); }
  .toc-nav a.on:hover{ background: color-mix(in srgb, var(--gold) 18%, #fff); border-left-color: var(--gold-d); }
  .toc-nav li.toc-h3 a{ padding-left:24px; font-size:.71rem; font-weight:500; letter-spacing:.15px; line-height:1.32; color:var(--muted); background:#fbfcfe; border-color:#f1f3f8; }
  .toc-nav li.toc-h3 a::before{ width:5px; height:5px; background:#d4dae6; box-shadow:0 0 0 1px #fff; border-width:1.5px; }
  .toc-nav li.toc-h3 a:hover{ color:var(--navy); background:#fff; border-color: color-mix(in srgb, var(--teal) 14%, var(--line)); }
  .toc-nav li.toc-h3 a:hover::before{ background:var(--teal); }
  .toc-nav li.toc-h3 a.on{ color:var(--teal); background: color-mix(in srgb, var(--teal) 9%, #fff); border-color: color-mix(in srgb, var(--teal) 18%, var(--line)); border-left-color: var(--teal); }
  .toc-nav li.toc-h3 a.on::before{ background:var(--teal); box-shadow:0 0 0 3px color-mix(in srgb, var(--teal) 18%, transparent); }

  /* Right sticky CTA */
  .post-cta-side{ position:sticky; top:88px; align-self:start; padding-top:40px; }
  .post-cta-sticky{ display:flex; flex-direction:column; gap:16px; }

  @media(max-width:1200px){
    .post-shell{ grid-template-columns:1fr; gap:0; width:min(880px,92vw); }
    .post-toc, .post-cta-side{ display:none; }
    .post-section{ padding-top:28px; }
  }
  @media(max-width:600px){
    .post-shell{ width:min(880px,92vw); }
  }
</style>
